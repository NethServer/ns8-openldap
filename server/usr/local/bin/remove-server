# shellcheck shell=dash disable=SC3001

set -e # exit on error

if [ "$#" -eq 0 ]; then
    echo "[ERROR] missing server ID number argument(s)"
    exit 1
fi

for serverid in "$@"; do
    if [ "${serverid}" = "${LDAP_SERVERID}" ]; then
        echo "[ERROR] Cannot remove the local running server itself"
        exit 1
    fi
done

# One ldapmodify for all serverIDs: separate calls trigger a syncrepl
# reconnection storm (rc -100 quitting).
tmpconfig=$(mktemp)
ldapsearch -Q -LLL -o ldif_wrap=no -b cn=config \
    '(|(objectClass=olcDatabaseConfig)(objectClass=olcGlobal))' olcSyncrepl olcServerID \
    > "${tmpconfig}"

# rc 16 (LDAP_NO_SUCH_ATTRIBUTE) means a peer already dropped the value through
# config replication: expected and idempotent, so tolerate it.
set +e
{
    for serverid in "$@"; do
        awk -v "targetid=${serverid}" -f "${FILTERS_DIR}/update-syncrepl.awk" < "${tmpconfig}"
    done
} | tee "remove-server-combined.ldif" | ldapmodify -Q -c
rc=$?
set -e

rm -f "${tmpconfig}"

if [ "${rc}" -ne 0 ] && [ "${rc}" -ne 16 ]; then
    exit "${rc}"
fi

